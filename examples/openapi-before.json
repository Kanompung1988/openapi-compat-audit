{
  "openapi": "3.1.0",
  "info": {"title": "Sample Payments API", "version": "1.0"},
  "paths": {
    "/v1/payments": {
      "post": {
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object", "properties": {"amount": {"type": "number"}, "currency": {"type": "string", "enum": ["THB", "USD"]}}, "required": ["amount"]
        }}}},
        "responses": {"201": {"description": "Payment created", "content": {"application/json": {"schema": {"type": "object", "properties": {"id": {"type": "string"}}, "required": ["id"]}}}}}
      }
    }
  }
}
